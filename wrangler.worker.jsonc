{
  "name": "fandian",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-16",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fandian-db",
      "database_id": "24d83dc7-f8e9-4141-92ae-9cff92ede7e2",
      "migrations_dir": "migrations"
    }
  ]
}
